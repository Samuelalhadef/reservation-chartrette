# =========================================================
#  Variables d'environnement — Réservation Chartrettes
#  À renseigner dans Portainer (onglet "Environment variables"
#  de la stack), PAS dans un fichier commité.
# =========================================================

# --- Stack "reservation-chartrettes" ---

# Port exposé sur l'hôte TrueNAS (le conteneur écoute toujours sur 3000 en interne)
APP_PORT=8080

# Chemin sur le TrueNAS du dataset contenant la base SQLite
DB_HOST_PATH=/mnt/tank/reservation-chartrettes/db

# Base SQLite locale (mode fichier libSQL).
# Par défaut : file:/data/app.db (chemin INTERNE au conteneur).
# Pour repointer vers Turso distant, mets une URL libsql://...
TURSO_DATABASE_URL=file:/data/app.db
# TURSO_AUTH_TOKEN= (uniquement si TURSO_DATABASE_URL pointe sur Turso distant)

# --- NextAuth ---
# URL publique EXACTE par laquelle on accède à l'app (= ce que tape l'utilisateur).
NEXTAUTH_URL=https://chartrettes-reservation.mousequetaire.com
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=changez_moi_avec_une_longue_chaine_aleatoire

# --- Google OAuth (laisser vide si non utilisé) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (NodeMailer) ---
# Compte SMTP du service informatique de la mairie : c'est lui qui expédie tous
# les mails de l'application (confirmations de réservation, codes de
# vérification, notifications).
# IMPORTANT : le serveur réécrit l'en-tête From vers EMAIL_SERVER_USER si
# EMAIL_FROM n'est pas ce compte ou un de ses alias autorisés. Les deux doivent
# donc désigner la même boîte.
EMAIL_SERVER_HOST=smtp.mairie-chartrettes.fr
# 465 = SSL implicite (défaut), 587 = STARTTLS
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=serviceinformatique@mairie-chartrettes.fr
EMAIL_SERVER_PASSWORD=mot_de_passe_du_compte

# Adresse affichée comme expéditeur (doit correspondre au compte SMTP ci-dessus)
EMAIL_FROM=serviceinformatique@mairie-chartrettes.fr
# Nom affiché à côté de l'adresse (défaut : "Réservation Chartrettes")
EMAIL_FROM_NAME=Réservation Chartrettes

# Contact métier de la mairie : destinataire des notifications admin (formulaire
# de contact, demandes de réservation à l'année) et adresse de réponse
# (Reply-To) des mails sortants — les réponses des associations arrivent ici,
# pas au service informatique.
EMAIL_ADMIN=animateur.culturel@mairie-chartrettes.fr

# --- OAuth2 Microsoft 365 (requis : Security Defaults bloque l'auth par mot de passe) ---
# Inscription d'application Entra ID + permission SMTP.SendAsApp (Office 365
# Exchange Online). Dès que ces trois variables sont remplies, EMAIL_SERVER_PASSWORD
# est ignoré.
EMAIL_OAUTH_TENANT_ID=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=

# --- Variante Resend ---------------------------------------------------------
# Repli si l'OAuth Microsoft 365 reste inaccessible. Aucun changement de code :
# Resend expose un relais SMTP standard. Le domaine doit être vérifié côté Resend
# (enregistrements DNS chez OVH), l'adresse EMAIL_FROM restant inchangée.
# Attention : l'offre gratuite plafonne à 100 mails/jour et 3 000/mois.
# EMAIL_SERVER_HOST=smtp.resend.com
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=resend
# EMAIL_SERVER_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx


# =========================================================
#  Stack "cloudflared-reservation" (tunnel public)
# =========================================================

# Token du tunnel Cloudflare (créé via Zero Trust → Networks → Tunnels)
TUNNEL_TOKEN=eyJhIjoi...colle_ton_token_ici...
